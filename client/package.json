{
  "name": "piscreen-client",
  "productName": "PiScreen",
  "version": "1.6.0",
  "description": "Send files and your screen to a Raspberry Pi running PiScreen",
  "author": "shattersprite",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.shattersprite.piscreen",
    "productName": "PiScreen",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PiScreen-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PiScreen"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shattersprite",
        "repo": "raspifileviewer",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
